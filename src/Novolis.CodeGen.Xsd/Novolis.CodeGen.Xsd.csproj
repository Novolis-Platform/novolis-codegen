<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.CodeGen.Xsd</PackageId>
    <Description>SchemaGraph → Roslyn SyntaxFactory emit profiles (Wire XmlSerializer, Lean records).</Description>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.CodeGen.Xsd</RootNamespace>
    <PackageTags>xsd;roslyn;codegen;xmlserializer;novolis</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.CodeGen.Xml\Novolis.CodeGen.Xml.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Consumers (tools) need Roslyn at runtime for SyntaxFactory emit. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
</Project>
